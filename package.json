{
  "name": "cobblestone-launcher-core",
  "version": "4.0.0",
  "description": "Backend-only Minecraft Java launcher core for Electron and Node.js hosts",
  "main": "backend/index.js",
  "bin": {
    "cobblestone": "backend/cli.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "node backend/cli.js doctor",
    "doctor": "node backend/cli.js doctor",
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "desktop": "npm run frontend:build && electron --no-sandbox electron/main.js",
    "desktop:dev": "node scripts/dev-desktop.js"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "modrinth",
    "curseforge",
    "fabric",
    "forge",
    "neoforge",
    "quilt"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2",
    "adm-zip": "^0.6.0",
    "msmc": "^5.0.5",
    "proper-lockfile": "^4.1.2",
    "tar": "^7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "electron": "44.0.0"
  }
}
