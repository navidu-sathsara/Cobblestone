{
  "name": "cobblestone-launcher-core",
  "version": "4.2.2",
  "description": "Backend-only Minecraft Java launcher core for Electron and Node.js hosts",
  "main": "backend/index.js",
  "bin": {
    "cobblestone": "backend/cli.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/cli.js doctor",
    "doctor": "node backend/cli.js doctor",
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "desktop": "npm run frontend:build && electron --no-sandbox electron/main.js",
    "desktop:dev": "node scripts/dev-desktop.js",
    "build:mac": "electron-builder --mac -p always",
    "build:win": "electron-builder --win -p always",
    "build:linux": "electron-builder --linux -p always",
    "build:all": "electron-builder -mwl -p always"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "modrinth",
    "curseforge",
    "fabric",
    "forge",
    "neoforge",
    "quilt"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "msmc": "^5.0.5",
    "proper-lockfile": "^4.1.2",
    "tar": "^7.5.22",
    "zod": "^4.5.4"
  },
  "build": {
    "appId": "com.cobblestone.launcher",
    "productName": "Cobblestone",
    "directories": {
      "output": "release"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "navidu-sathsara",
      "repo": "Cobblestone",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  }
}
